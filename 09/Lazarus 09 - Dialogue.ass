Dialogue: 9,0:04:07.16,0:04:09.12,Main,,0,0,0,,Cuối cùng cũng đến buổi điều trần.
Dialogue: 9,0:04:09.12,0:04:10.31,Main,,0,0,0,,Ông chuẩn bị xong chưa?
Dialogue: 9,0:04:10.71,0:04:11.86,Main,,0,0,0,,Dĩ nhiên rồi.
Dialogue: 9,0:04:11.86,0:04:14.23,Main,,0,0,0,,Không lẽ ông đang căng thẳng à?
Dialogue: 9,0:04:15.18,0:04:16.03,Main,,0,0,0,,Không.
Dialogue: 9,0:04:17.30,0:04:19.91,Main,,0,0,0,,Quả là người được mệnh danh là AI.
Dialogue: 9,0:04:20.88,0:04:22.61,Main,,0,0,0,,Không có gì đâu ạ.
Dialogue: 9,0:04:23.01,0:04:25.78,Main,,0,0,0,,Vậy chúng ta đi thôi nhỉ.
Dialogue: 9,0:04:37.62,0:04:38.95,Main,,0,0,0,,Chị thấy thế nào?
Dialogue: 9,0:04:38.95,0:04:40.44,Main,,0,0,0,,Không sao, không sao.
Dialogue: 9,0:04:43.74,0:04:45.32,Main,,0,0,0,,Chị vẫn nên nằm nghỉ đi.
Dialogue: 9,0:04:46.95,0:04:48.98,Main,,0,0,0,,Lại làm phiền em rồi.
Dialogue: 9,0:04:50.16,0:04:51.94,Main,,0,0,0,,Giúp đỡ lẫn nhau thôi mà.
Dialogue: 9,0:04:52.29,0:04:53.79,Main,,0,0,0,,Axel đâu rồi?
Dialogue: 9,0:04:53.79,0:04:55.88,Main,,0,0,0,,Anh ấy đi mua đồ cùng Doug rồi.
Dialogue: 9,0:04:55.88,0:04:58.72,Main,,0,0,0,,Ủa? Con mèo này từ lúc nào mà...
Dialogue: 9,0:04:58.72,0:05:01.65,Main,,0,0,0,,Vâng, vốn chả thân với ai cả.
Dialogue: 9,0:05:02.36,0:05:06.28,Main,,0,0,0,,Nhưng xem ra nó đã tự tìm được \Nchỗ của mình rồi.
Dialogue: 9,0:05:10.56,0:05:12.94,Main,,0,0,0,,Tạm thời có bao nhiêu \Ntôi mua hết bấy nhiêu rồi.
Dialogue: 9,0:05:15.09,0:05:18.50,Main,,0,0,0,,Tôi đã tắt camera hành trình \Nđể không ai nghe được cuộc nói chuyện.
Dialogue: 9,0:05:18.90,0:05:20.55,Main,,0,0,0,,không lẽ anh...
Dialogue: 9,0:05:21.07,0:05:22.54,Main,,0,0,0,,định tỏ tình với tôi đấy à?
Dialogue: 9,0:05:24.66,0:05:28.24,Main,,0,0,0,,Dù mai có là tận thế \Nthì cũng chả thèm đâu.
Dialogue: 9,0:05:28.24,0:05:29.35,Main,,0,0,0,,Ra thế.
Dialogue: 9,0:05:29.86,0:05:30.72,Main,,0,0,0,,Anh nghĩ sao?
Dialogue: 9,0:05:31.20,0:05:31.94,Main,,0,0,0,,Về chuyện gì?
Dialogue: 9,0:05:32.42,0:05:35.31,Main,,0,0,0,,Nếu chúng ta tóm được Skinner...
Dialogue: 9,0:05:35.71,0:05:38.25,Main,,0,0,0,,anh có nghĩ chúng ta sẽ được\N thả tự do như đã hứa không?
Dialogue: 9,0:05:38.25,0:05:39.63,Main,,0,0,0,,Ai mà biết.
Dialogue: 9,0:05:39.63,0:05:42.72,Main,,0,0,0,,Chúng ta đã biết quá nhiều bí mật rồi.
Dialogue: 9,0:05:42.72,0:05:43.84,Main,,0,0,0,,Vấn đề dó.
Dialogue: 9,0:05:43.84,0:05:48.10,Main,,0,0,0,,Họ cố tình thành lập Lazarus như một biệt đội\N thay vì dùng chính NSA là vì...
Dialogue: 9,0:05:48.10,0:05:49.93,Main,,0,0,0,,Sau khi xong việc,
Dialogue: 9,0:05:49.93,0:05:52.89,Main,,0,0,0,,họ sẽ thủ tiêu luôn chúng ta\N cùng với những bí mật đó?
Dialogue: 9,0:05:52.89,0:05:56.06,Main,,0,0,0,,Hiếm khi tôi với anh lại chung quan điểm.
Dialogue: 9,0:05:56.06,0:05:57.27,Main,,0,0,0,,Vui ha.
Dialogue: 9,0:05:57.27,0:05:58.74,Main,,0,0,0,,Và bọn họ...
Dialogue: 9,0:05:58.90,0:06:02.38,Main,,0,0,0,,chắc chắn sẽ tìm cách dò xét xem\N chúng ta đã biết đến đâu.
Dialogue: 9,0:06:07.58,0:06:10.45,Main,,0,0,0,,Hayes, lâu rồi không gặp.
Dialogue: 9,0:06:10.45,0:06:13.50,Main,,0,0,0,,Ồ Abel, trông ông vẫn khỏe.
Dialogue: 9,0:06:13.50,0:06:14.73,Main,,0,0,0,,Ông cũng vậy.
Dialogue: 9,0:06:15.25,0:06:17.48,Main,,0,0,0,,Để tôi giới thiệu, đây là...
Dialogue: 9,0:06:20.05,0:06:21.44,Main,,0,0,0,,Thôi để gặp sau.
Dialogue: 9,0:06:22.72,0:06:23.63,Main,,0,0,0,,Người quen của ông à?
Dialogue: 9,0:06:23.90,0:06:25.47,Main,,0,0,0,,Sĩ quan Hayes.
Dialogue: 9,0:06:25.47,0:06:27.80,Main,,0,0,0,,Là đồng đội cùng khóa \Nthời mũ nồi xanh.
Dialogue: 9,0:06:29.22,0:06:33.56,Main,,0,0,0,,Ông ta là lính Lục quân chuyên nghiệp,\N một quân nhân chính hiệu.
Dialogue: 9,0:06:33.56,0:06:34.64,Main,,0,0,0,,Còn người kia?
Dialogue: 9,0:06:35.00,0:06:37.15,Main,,0,0,0,,Schneider của Cục Tình báo.
Dialogue: 9,0:06:37.15,0:06:40.48,Main,,0,0,0,,Tôi chưa gặp mặt bao giờ, \Nnhưng nghe nói rất sắc sảo.
Dialogue: 9,0:06:40.48,0:06:42.30,Main,,0,0,0,,Vậy là đối thủ đã xuất hiện rồi.
Dialogue: 9,0:06:46.61,0:06:50.24,Main,,0,0,0,,Vậy buổi điều trần xin được bắt đầu.
Dialogue: 9,0:06:50.24,0:06:54.75,Main,,0,0,0,,Chủ đề là về việc\N duy trì hoạt động của đội S5,
Dialogue: 9,0:06:54.75,0:06:59.34,Main,,0,0,0,,thường được gọi là Lazarus, \Nđược thành lập dưới sự bảo trợ của NSA gần đây.
Dialogue: 9,0:06:59.68,0:07:02.50,Main,,0,0,0,,Hãy bắt đầu báo cáo.
Dialogue: 9,0:07:03.46,0:07:07.53,Main,,0,0,0,,Với mục đích bắt giữ Skinner,\N đội Lazarus đã được đặc biệt thành lập.
Dialogue: 9,0:07:08.22,0:07:10.28,Main,,0,0,0,,Tuy nhiên, sau vụ nổ súng trong thành phố,
Dialogue: 9,0:07:10.51,0:07:12.41,Main,,0,0,0,,vụ bắn rơi trực thăng,
Dialogue: 9,0:07:12.64,0:07:16.04,Main,,0,0,0,,và vụ hỏa hoạn lớn tại giáo phái,
Dialogue: 9,0:07:16.04,0:07:20.59,Main,,0,0,0,,họ đang rất bị nghi ngờ\N về vụ cháy giếng dầu ở Nga.
Dialogue: 9,0:07:20.94,0:07:23.18,Main,,0,0,0,,Và đã xác nhận được rằng\N ngay trước vụ hỏa hoạn, 
Dialogue: 9,0:07:23.18,0:07:25.70,Main,,0,0,0,,đội Lazarus đã đáp xuống \Nmột địa điểm rất gần đó,
Dialogue: 9,0:07:25.70,0:07:29.76,Main,,0,0,0,,bằng trực thăng của quân đội Mỹ\N tại châu Âu.
Dialogue: 9,0:07:30.16,0:07:34.29,Main,,0,0,0,,Rõ ràng khả năng Lazarus có liên quan \Nlà gần như chắc chắn.
Dialogue: 9,0:07:34.29,0:07:35.89,Main,,0,0,0,,Ông thấy sao, Abel?
Dialogue: 9,0:07:37.62,0:07:38.60,Main,,0,0,0,,Tôi không phản đối.
Dialogue: 9,0:07:39.63,0:07:42.50,Main,,0,0,0,,Hơn nữa, một trong \Ncác thành viên của Lazarus
Dialogue: 9,0:07:42.50,0:07:44.72,Main,,0,0,0,,là cựu điệp viên Nga.
Dialogue: 9,0:07:45.05,0:07:49.76,Main,,0,0,0,,Phải chăng thông tin đã bị rò rỉ \Ncho phía Nga?
Dialogue: 9,0:07:49.76,0:07:52.72,Main,,0,0,0,,Vấn đề lớn hơn là chuỗi hành động này...
Dialogue: 9,0:07:52.72,0:07:56.12,Main,,0,0,0,,không hề liên quan trực tiếp\N đến việc bắt giữ Skinner.
Dialogue: 9,0:07:58.06,0:07:59.23,Main,,0,0,0,,Có vẻ...
Dialogue: 9,0:07:59.23,0:08:02.82,Main,,0,0,0,,chúng ta cần phải chứng minh\N liệu Lazarus có thực sự...
Dialogue: 9,0:08:02.82,0:08:05.13,Main,,0,0,0,,đang tìm kiếm Skinner hay không.
Dialogue: 9,0:08:05.94,0:08:07.40,Main,,0,0,0,,Lần này, chúng tôi
Dialogue: 9,0:08:07.40,0:08:11.53,Main,,0,0,0,,đã thành công liên lạc với \Nmột thành viên của Lazarus,
Dialogue: 9,0:08:11.53,0:08:14.59,Main,,0,0,0,,và đã nhận được lời hứa làm chứng.
Dialogue: 9,0:08:15.66,0:08:20.18,Main,,0,0,0,,Cho phép triệu tập nhân chứng \Nđến để đưa ra lời khai.
Dialogue: 9,0:08:25.59,0:08:27.34,Main,,0,0,0,,Có gián điệp à?
Dialogue: 9,0:08:27.99,0:08:29.19,Main,,0,0,0,,Thật ra...
Dialogue: 9,0:08:29.59,0:08:32.82,Main,,0,0,0,,tôi đã thấy Leland có hai điện thoại.
Dialogue: 9,0:08:33.39,0:08:36.95,Main,,0,0,0,,Không có bằng chứng chắc chắn, \Nnhưng cứ để ý đến cậu ta đi.
Dialogue: 9,0:08:39.35,0:08:40.94,Main,,0,0,0,,Tên cậu là gì?
Dialogue: 9,0:08:40.94,0:08:42.44,Main,,0,0,0,,Leland Astor.
Dialogue: 9,0:08:42.69,0:08:45.48,Main,,0,0,0,,Cậu, với tư cách là thành viên của Lazarus,
Dialogue: 9,0:08:45.48,0:08:48.82,Main,,0,0,0,,đã giám sát hành động của họ \Ntừ bên trong.
Dialogue: 9,0:08:48.82,0:08:49.51,Main,,0,0,0,,Có đúng không?
Dialogue: 9,0:08:50.28,0:08:51.07,Main,,0,0,0,,Đúng.
Dialogue: 9,0:08:51.34,0:08:53.58,Main,,0,0,0,,Trước hết, về chiến dịch ở Bắc Cực,
Dialogue: 9,0:08:53.58,0:08:57.70,Main,,0,0,0,,có cần thiết cho việc \Ntìm kiếm Skinner không?
Dialogue: 9,0:08:57.97,0:08:58.80,Main,,0,0,0,,Không.
Dialogue: 9,0:08:59.12,0:09:01.78,Main,,0,0,0,,Đó là hành động để giải cứu Chris,
Dialogue: 9,0:09:02.08,0:09:04.61,Main,,0,0,0,,không liên quan trực tiếp đến Skinner.
Dialogue: 9,0:09:06.09,0:09:09.59,Main,,0,0,0,,Hành động lần này có nguy cơ \Ngây căng thẳng quốc tế,
Dialogue: 9,0:09:09.59,0:09:13.36,Main,,0,0,0,,nhưng lại chỉ để cứu\N một thành viên thôi sao?
Dialogue: 9,0:09:13.76,0:09:14.58,Main,,0,0,0,,Đúng.
Dialogue: 9,0:09:18.16,0:09:20.69,Main,,0,0,0,,Chị Chris, đừng cử động thì hơn...
Dialogue: 9,0:09:20.69,0:09:22.14,Main,,0,0,0,,Nhưng mà ấy.
Dialogue: 9,0:09:22.14,0:09:24.92,Main,,0,0,0,,Trong lúc chị nghỉ ngơi \Nthì thế giới đang dần kết thúc.
Dialogue: 9,0:09:30.86,0:09:32.77,Main,,0,0,0,,Cái gì đây?
Dialogue: 9,0:09:37.83,0:09:39.20,Main,,0,0,0,,Tuy nhiên,
Dialogue: 9,0:09:39.20,0:09:42.58,Main,,0,0,0,,Chris là một nhân tố \Nkhông thể thiếu để bắt giữ Skinner.
Dialogue: 9,0:09:42.87,0:09:43.90,Main,,0,0,0,,Nói cách khác, việc này...
Dialogue: 9,0:09:44.50,0:09:48.32,Main,,0,0,0,,cũng có thể nói là một hành động \Ncần thiết cho việc tìm kiếm Skinner.
Dialogue: 9,0:09:48.54,0:09:50.03,Main,,0,0,0,,Ý cậu là...
Dialogue: 9,0:09:50.30,0:09:53.47,Main,,0,0,0,,vì nguyên nhân đó mà \Ncăng thẳng quốc tế cũng không sao?
Dialogue: 9,0:09:53.47,0:09:54.21,Main,,0,0,0,,Không.
Dialogue: 9,0:09:54.39,0:09:58.47,Main,,0,0,0,,Nhưng hiện tại, việc bắt giữ Skinner\N phải là ưu tiên hàng đầu.
Dialogue: 9,0:09:58.47,0:10:02.79,Main,,0,0,0,,Họ có thực sự tìm kiếm Skinner không?
Dialogue: 9,0:10:03.19,0:10:05.48,Main,,0,0,0,,Hay là làm việc gì đó khác?
Dialogue: 9,0:10:05.48,0:10:06.40,Main,,0,0,0,,Không.
Dialogue: 9,0:10:06.61,0:10:09.71,Main,,0,0,0,,Theo như tôi biết \Nthì không có hành động nào như vậy.
Dialogue: 9,0:10:10.32,0:10:12.24,Main,,0,0,0,,Tôi vẫn còn thắc mắc.
Dialogue: 9,0:10:12.48,0:10:16.95,Main,,0,0,0,,Ví dụ như lý lịch của một thành viên tên\N Axel Gilberto.
Dialogue: 9,0:10:17.41,0:10:21.56,Main,,0,0,0,,Có ghi là anh ta từng ở tù, \Nnhưng thông tin chi tiết chưa được rõ ràng.
Dialogue: 9,0:10:21.84,0:10:23.02,Main,,0,0,0,,Chuyện đó...
Dialogue: 9,0:10:23.52,0:10:25.73,Main,,0,0,0,,tôi cũng không biết, nhưng...
Dialogue: 9,0:10:26.04,0:10:30.05,Main,,0,0,0,,có lẽ là do phía nhà tù không muốn bị lộ \Nviệc anh ấy đã vượt ngục vô số lần,
Dialogue: 9,0:10:30.05,0:10:31.65,Main,,0,0,0,,nên đã che giấu chăng?
Dialogue: 9,0:10:32.17,0:10:35.16,Main,,0,0,0,,Vượt ngục vô số lần ư?
Dialogue: 9,0:10:35.46,0:10:36.86,Main,,0,0,0,,Tôi nghe được là vậy.
Dialogue: 9,0:10:37.26,0:10:41.70,Main,,0,0,0,,Từ băng tuyết ở Alaska cho đến sa mạc Arizona.
Dialogue: 9,0:10:45.42,0:10:47.34,Main,,0,0,0,,Nhân chứng đã có thể lui ra.
Dialogue: 9,0:10:47.94,0:10:49.27,Main,,0,0,0,,Dù sao đi nữa,
Dialogue: 9,0:10:49.27,0:10:52.94,Main,,0,0,0,,quan điểm của chúng tôi là không thể\N trốn tránh trách nhiệm
Dialogue: 9,0:10:52.94,0:10:55.30,Main,,0,0,0,,về những vấn đề\N mà Lazarus đã gây ra.
Dialogue: 9,0:10:57.62,0:10:58.57,Main,,0,0,0,,Xin lỗi đã làm phiền.
Dialogue: 9,0:10:58.83,0:11:00.49,Main,,0,0,0,,Có chuyện gì vậy?
Dialogue: 9,0:11:00.49,0:11:04.21,Main,,0,0,0,,Vừa có video tuyên bố mới từ Skinner.
Dialogue: 9,0:11:06.54,0:11:09.35,Main,,0,0,0,,Đã 20 ngày trôi qua kể từ \Ntuyên bố đầu tiên.
Dialogue: 9,0:11:09.92,0:11:14.05,Main,,0,0,0,,Nhưng, vẫn chưa có ai đến tìm tôi.
Dialogue: 9,0:11:14.55,0:11:18.39,Main,,0,0,0,,Các quốc gia cứ như thể \Nchưa từng có chuyện gì xảy ra.
Dialogue: 9,0:11:18.39,0:11:21.11,Main,,0,0,0,,Vẫn tiếp tục tranh giành ở Bắc Cực.
Dialogue: 9,0:11:21.74,0:11:25.62,Main,,0,0,0,,Thậm chí còn đứng trước \Nnguy cơ chiến tranh.
Dialogue: 9,0:11:26.52,0:11:30.25,Main,,0,0,0,,Nhân loại đã từ bỏ việc sinh tồn rồi sao?
Dialogue: 9,0:11:31.32,0:11:34.75,Main,,0,0,0,,10 ngày nữa,\N đối tượng thử nghiệm đầu tiên sẽ chết.
Dialogue: 9,0:11:35.58,0:11:37.33,Main,,0,0,0,,Đối tượng thử nghiệm đầu tiên đó...
Dialogue: 9,0:11:37.62,0:11:39.39,Main,,0,0,0,,chính là tôi.
Dialogue: 9,0:11:40.07,0:11:42.76,Main,,0,0,0,,Nếu trong 10 ngày nữa các vị không tìm ra tôi,
Dialogue: 9,0:11:43.16,0:11:45.75,Main,,0,0,0,,hy vọng sẽ vĩnh viễn biến mất.
Dialogue: 9,0:11:45.75,0:11:46.64,Main,,0,0,0,,Không lẽ...
Dialogue: 9,0:11:47.16,0:11:49.29,Main,,0,0,0,,Lão ta không uống thuốc giải sao?
Dialogue: 9,0:11:49.29,0:11:52.00,Main,,0,0,0,,Người quyết định thế giới \Nsau 10 ngày nữa
Dialogue: 9,0:11:52.00,0:11:53.90,Main,,0,0,0,,chính là các vị.
Dialogue: 9,0:11:54.51,0:11:57.78,Main,,0,0,0,,Tôi chỉ có thể nói được \Nbấy nhiêu thôi.
Dialogue: 9,0:12:04.97,0:12:06.91,Main,,0,0,0,,C-Có gì đáng cười sao?
Dialogue: 9,0:12:07.44,0:12:10.83,Main,,0,0,0,,Tôi hoàn toàn đồng ý với Skinner.
Dialogue: 9,0:12:11.23,0:12:15.38,Main,,0,0,0,,Tất cả những gì tôi muốn nói, \Nông ta đã nói hết rồi.
Dialogue: 9,0:12:15.78,0:12:17.34,Main,,0,0,0,,Ý ông là sao?
Dialogue: 9,0:12:17.86,0:12:21.09,Main,,0,0,0,,Chúng ta không có thời gian \Ncho vở kịch ngớ ngẩn này.
Dialogue: 9,0:12:22.24,0:12:24.49,Main,,0,0,0,,Ngáng chân đồng đội,
Dialogue: 9,0:12:24.49,0:12:28.19,Main,,0,0,0,,hay làm những trò đâm sau lưng \Nthì được cái ích gì?
Dialogue: 9,0:12:28.90,0:12:32.80,Main,,0,0,0,,Chúng tôi chỉ còn cách Skinner\N một bước nữa thôi.
Dialogue: 9,0:12:33.34,0:12:35.61,Main,,0,0,0,,Nếu bây giờ giải tán Lazarus,
Dialogue: 9,0:12:36.05,0:12:37.98,Main,,0,0,0,,rồi không tìm được Skinner,
Dialogue: 9,0:12:38.22,0:12:40.13,Main,,0,0,0,,ai sẽ chịu trách nhiệm đây?
Dialogue: 9,0:12:40.45,0:12:45.97,Main,,0,0,0,,Liệu ai có thể chịu trách nhiệm \Ncho tận thế?
Dialogue: 9,0:12:48.83,0:12:50.70,Main,,0,0,0,,Cũng không còn cách nào khác.
Dialogue: 9,0:12:50.70,0:12:51.88,Main,,0,0,0,,Chủ tịch?
Dialogue: 9,0:12:52.27,0:12:55.67,Main,,0,0,0,,Tạm thời cho phép Lazarus \Ntiếp tục hoạt động.
Dialogue: 9,0:12:56.07,0:12:59.03,Main,,0,0,0,,Không cần phải nói, thời hạn là 10 ngày.
Dialogue: 9,0:12:59.03,0:13:02.21,Main,,0,0,0,,Trong khoảng thời gian đó\N hãy bắt ông ta đi.
Dialogue: 9,0:13:02.62,0:13:05.31,Main,,0,0,0,,Vậy là đồng quan điểm rồi.
Dialogue: 9,0:13:06.87,0:13:08.12,Main,,0,0,0,,Quả nhiên là...
Dialogue: 9,0:13:08.12,0:13:11.22,Main,,0,0,0,,người đã trốn thoát khỏi\N nhà tù Eyman ở Arizona,
Dialogue: 9,0:13:11.62,0:13:14.79,Main,,0,0,0,,không sai được, chính là Axel Gilberto.
Dialogue: 9,0:13:14.79,0:13:16.36,Main,,0,0,0,,Tại sao không có dữ liệu?
Dialogue: 9,0:13:16.61,0:13:17.51,Main,,0,0,0,,Có lẽ...
Dialogue: 9,0:13:17.51,0:13:20.00,Main,,0,0,0,,đã dùng hacker để xóa đi rồi
Dialogue: 9,0:13:20.22,0:13:23.18,Main,,0,0,0,,Tức là có điều không muốn bị biết à?
Dialogue: 9,0:13:23.18,0:13:25.03,Main,,0,0,0,,Chỉ còn nước ra tay thôi.
Dialogue: 9,0:13:25.55,0:13:27.41,Main,,0,0,0,,Đừng xem thường Abel.
Dialogue: 9,0:13:27.41,0:13:29.56,Main,,0,0,0,,Lão rất nhạy đấy.
Dialogue: 9,0:13:29.56,0:13:31.64,Main,,0,0,0,,Bất cẩn sẽ bị phát hiện ngay.
Dialogue: 9,0:13:31.64,0:13:35.34,Main,,0,0,0,,Dĩ nhiên là chúng ta không ngu gì\N tự thân hành động.
Dialogue: 9,0:13:35.66,0:13:36.96,Main,,0,0,0,,Hơn nữa,
Dialogue: 9,0:13:37.19,0:13:41.84,Main,,0,0,0,,kẻ ra tay là một nhân vật giống như bóng ma\N mà chưa ai từng gặp qua.
Dialogue: 9,0:13:42.82,0:13:44.08,Main,,0,0,0,,Bóng ma?
Dialogue: 9,0:13:45.78,0:13:47.09,Main,,0,0,0,,Leland.
Dialogue: 9,0:13:47.83,0:13:49.02,Main,,0,0,0,,Thằng cháu đây rồi.
Dialogue: 9,0:13:50.05,0:13:51.46,Main,,0,0,0,,Làm bác hết hồn đấy.
Dialogue: 9,0:13:52.10,0:13:53.42,Main,,0,0,0,,Cháu xin lỗi.
Dialogue: 9,0:13:53.42,0:13:56.67,Main,,0,0,0,,Lúc cháu bắt đầu đưa ra lời khai\N bất lợi cho chúng ta, bác thề...
Dialogue: 9,0:13:56.67,0:13:58.25,Main,,0,0,0,,đã nghĩ đến việc khử cháu đó.
Dialogue: 9,0:13:58.25,0:14:01.06,Main,,0,0,0,,Ấy, bác cứ đùa.
Dialogue: 9,0:14:01.06,0:14:03.26,Main,,0,0,0,,Tại sao còn giấu cả tôi?
Dialogue: 9,0:14:03.26,0:14:05.11,Main,,0,0,0,,À, đó là bởi...
Dialogue: 9,0:14:06.01,0:14:08.54,Main,,0,0,0,,muốn lừa được địch \Nthì trước hết phải lừa được ta.
Dialogue: 9,0:14:09.84,0:14:10.96,Main,,0,0,0,,Xin lỗi cô.
Dialogue: 9,0:14:11.64,0:14:15.36,Main,,0,0,0,,Bên đã liên lạc với Leland \Nlà Cục Tình báo Lục quân phải không?
Dialogue: 9,0:14:15.71,0:14:19.40,Main,,0,0,0,,Họ không tiết lộ danh tính, \Nnhưng chắc là vậy.
Dialogue: 9,0:14:19.40,0:14:21.42,Main,,0,0,0,,Chắc họ nghĩ cháu sẽ phản bội.
Dialogue: 9,0:14:22.03,0:14:26.03,Main,,0,0,0,,Nhưng xem ra việc \NAbel là bạn thân của cha cháu,
Dialogue: 9,0:14:26.03,0:14:27.58,Main,,0,0,0,,họ không hề hay biết.
Dialogue: 9,0:14:40.80,0:14:43.15,Main,,0,0,0,,Cảm ơn vì đã yêu cầu dịch vụ.
Dialogue: 9,0:14:43.84,0:14:46.82,Main,,0,0,0,,Vậy, chúng tôi sẽ đến chỗ ngài.
Dialogue: 9,0:14:57.40,0:14:59.02,Main,,0,0,0,,Đời như đời.
Dialogue: 9,0:14:59.39,0:15:02.82,Main,,0,0,0,,Không ngờ người chết đầu tiên\N lại là Skinner.
Dialogue: 9,0:15:02.82,0:15:04.21,Main,,0,0,0,,Nguy to rồi.
Dialogue: 9,0:15:04.78,0:15:06.13,Main,,0,0,0,,À, Chris.
Dialogue: 9,0:15:06.13,0:15:07.20,Main,,0,0,0,,Ổn cả chứ?
Dialogue: 9,0:15:07.20,0:15:07.91,Main,,0,0,0,,Ổn.
Dialogue: 9,0:15:07.91,0:15:10.70,Main,,0,0,0,,Xem ra giờ không phải là lúc \Nđể ngủ nghỉ cho đã nhỉ.
Dialogue: 9,0:15:10.70,0:15:12.69,Main,,0,0,0,,Đã xem tuyên bố của Skinner chưa?
Dialogue: 9,0:15:12.95,0:15:14.54,Main,,0,0,0,,Vừa xem rồi ạ.
Dialogue: 9,0:15:14.54,0:15:17.79,Main,,0,0,0,,Có vẻ Skinner không uống thuốc giải.
Dialogue: 9,0:15:18.06,0:15:19.20,Main,,0,0,0,,Đúng là thế rồi.
Dialogue: 9,0:15:19.46,0:15:22.34,Main,,0,0,0,,Tức là chúng ta không còn\N một giây nào để lãng phí nữa.
Dialogue: 9,0:15:22.34,0:15:23.09,Main,,0,0,0,,Nhưng mà...
Dialogue: 9,0:15:23.09,0:15:25.73,Main,,0,0,0,,vẫn chưa có manh mối mới nào cả.
Dialogue: 9,0:15:26.13,0:15:27.70,Main,,0,0,0,,À, đúng rồi.
Dialogue: 9,0:15:28.22,0:15:29.73,Main,,0,0,0,,Điều tra cái này đi.
Dialogue: 9,0:15:31.47,0:15:33.97,Main,,0,0,0,,Thuốc gì đây?
Dialogue: 9,0:15:33.97,0:15:36.77,Main,,0,0,0,,Trước đây tôi nhặt được ở nhà Skinner.
Dialogue: 9,0:15:36.77,0:15:37.71,Main,,0,0,0,,Nhà Skinner?
Dialogue: 9,0:15:37.71,0:15:39.71,Main,,0,0,0,,Sao bây giờ mới lôi ra?
Dialogue: 9,0:15:39.71,0:15:41.98,Main,,0,0,0,,Thì tại quên mất thôi.
Dialogue: 9,0:15:41.98,0:15:45.30,Main,,0,0,0,,Chắc lại nằm trong \Nđống quần áo bừa bãi của cô chứ gì.
Dialogue: 9,0:15:45.30,0:15:47.33,Main,,0,0,0,,Ôi vãi, sao cậu biết?
Dialogue: 9,0:15:47.61,0:15:49.73,Main,,0,0,0,,Trước mắt, cứ điều tra xem sao.
Dialogue: 9,0:15:53.41,0:15:54.93,Main,,0,0,0,,Sắp đến lúc rồi.
Dialogue: 9,0:15:57.96,0:16:01.31,Main,,0,0,0,,Hân hạnh được gặp mặt, \Ncác vị là người ủy thác phải không?
Dialogue: 9,0:16:01.92,0:16:02.69,Main,,0,0,0,,Anh là?
Dialogue: 9,0:16:03.09,0:16:06.38,Main,,0,0,0,*Song Long,Người đại diện của Soryu,\N tôi là HQ.
Dialogue: 9,0:16:06.38,0:16:08.03,Main,,0,0,0,,Rất mong được hợp tác.
Dialogue: 9,0:16:09.90,0:16:13.60,Main,,0,0,0,,Xin lỗi, nhưng chúng tôi \Nkhông thể tiết lộ danh tính.
Dialogue: 9,0:16:13.60,0:16:14.99,Main,,0,0,0,,Như vậy có ổn không?
Dialogue: 9,0:16:15.39,0:16:17.04,Main,,0,0,0,,Hoàn toàn ổn.
Dialogue: 9,0:16:17.56,0:16:21.62,Main,,0,0,0,,Chỉ cần nhận được thông tin chính xác \Nvề mục tiêu và thù lao là được.
Dialogue: 9,0:16:22.02,0:16:24.65,Main,,0,0,0,,Về cái tên Song Long đó,
Dialogue: 9,0:16:24.65,0:16:26.32,Main,,0,0,0,,nghe nói chưa ai từng thấy mặt,
Dialogue: 9,0:16:26.32,0:16:29.30,Main,,0,0,0,,và được mệnh danh là "sát thủ ảo ảnh".
Dialogue: 9,0:16:29.86,0:16:32.20,Main,,0,0,0,,Rốt cuộc anh ta là ai?
Dialogue: 9,0:16:32.53,0:16:34.69,Main,,0,0,0,,Tôi chỉ là người đại diện.
Dialogue: 9,0:16:35.24,0:16:38.22,Main,,0,0,0,,Không biết gì về quá khứ hay thân thế.
Dialogue: 9,0:16:38.62,0:16:39.60,Main,,0,0,0,,Hơn nữa...
Dialogue: 9,0:16:40.21,0:16:43.90,Main,,0,0,0,,chính tôi cũng chưa từng gặp anh ta.
Dialogue: 9,0:16:44.08,0:16:45.17,Main,,0,0,0,,Cái gì cơ?
Dialogue: 9,0:16:45.17,0:16:49.39,Main,,0,0,0,,Tuy nhiên, về công việc đã nhận,\N đảm bảo sẽ được hoàn thành.
Dialogue: 9,0:16:50.30,0:16:51.41,Main,,0,0,0,,Thôi được.
Dialogue: 9,0:16:51.41,0:16:55.64,Main,,0,0,0,,Nhưng có tin đồn là thù lao khá cao.
Dialogue: 9,0:16:55.64,0:16:58.93,Main,,0,0,0,,30 triệu đô la một vụ, miễn thuế.
Dialogue: 9,0:16:59.85,0:17:02.63,Main,,0,0,0,,Ra vậy, đúng như lời đồn.
Dialogue: 9,0:17:03.15,0:17:05.11,Main,,0,0,0,,Nếu các vị thấy không được,
Dialogue: 9,0:17:05.11,0:17:07.15,Main,,0,0,0,,thì coi như không hợp đồng gì cả.
Dialogue: 9,0:17:07.15,0:17:08.00,Main,,0,0,0,,Khoan đã.
Dialogue: 9,0:17:08.27,0:17:12.20,Main,,0,0,0,,Nếu muốn chúng tôi trả một số tiền lớn như vậy\N cho một kẻ như bóng ma,
Dialogue: 9,0:17:12.20,0:17:15.22,Main,,0,0,0,,tôi nghĩ vẫn nên \Nchứng minh thực lực trước.
Dialogue: 9,0:17:15.78,0:17:17.22,Main,,0,0,0,,Cần kiểm tra sao?
Dialogue: 9,0:17:17.95,0:17:19.04,Main,,0,0,0,,Không thành vấn đề.
Dialogue: 9,0:17:19.04,0:17:22.67,Main,,0,0,0,,Tuy nhiên,\N dù kết quả của bài kiểm tra có như nào,
Dialogue: 9,0:17:22.67,0:17:24.23,Main,,0,0,0,,chúng tôi cũng không chịu trách nhiệm.
Dialogue: 9,0:17:24.75,0:17:25.85,Main,,0,0,0,,Đã hiểu.
Dialogue: 9,0:17:26.25,0:17:30.34,Main,,0,0,0,,Chúng tôi sẽ tiến hành thủ tục chuyển tiền \Nsau khi xác nhận kiểm tra hoàn tất.
Dialogue: 9,0:17:30.34,0:17:31.76,Main,,0,0,0,,Địa điểm kiểm tra ở đâu?
Dialogue: 9,0:17:31.76,0:17:32.86,Main,,0,0,0,,Ở mặt sau tấm thẻ.
Dialogue: 9,0:17:34.70,0:17:36.62,Main,,0,0,0,,Vậy, tôi xin phép.
Dialogue: 9,0:17:57.16,0:17:59.77,Main,,0,0,0,,Nhưng mà, đối phó với một người \Nmà trang bị thế này cơ à.
Dialogue: 9,0:17:59.77,0:18:02.16,Main,,0,0,0,,Bộ có xe tăng hay gì à?
Dialogue: 9,0:18:02.16,0:18:05.29,Main,,0,0,0,,Mà, cứ xả đạn thế này\N thì cả anh cũng bắn trúng thôi.
Dialogue: 9,0:18:05.29,0:18:08.75,Main,,0,0,0,,Chuẩn luôn, lỗ chỗ như rổ luôn.
Dialogue: 9,0:18:08.75,0:18:11.42,Main,,0,0,0,,Tối nay không ăn được Sloppy joe rồi.
Dialogue: 9,0:18:13.06,0:18:15.84,Main,,0,0,0,,Mục tiêu là một người. \NSống chết không quan trọng.
Dialogue: 9,0:18:15.84,0:18:18.51,Main,,0,0,0,,Tuy nhiên, không biết có bẫy gì không.
Dialogue: 9,0:18:18.51,0:18:19.68,Main,,0,0,0,,Nhớ cẩn thận.
Dialogue: 9,0:18:19.94,0:18:23.71,Main,,0,0,0,,Nhiệm vụ kết thúc khi xác nhận đối phương\N đã bị vô hiệu hóa.
Dialogue: 9,0:18:58.72,0:19:01.68,Main,,0,0,0,,Xác nhận một nguồn nhiệt tại 7D.
Dialogue: 9,0:19:01.68,0:19:04.28,Main,,0,0,0,,Hắn đang chờ mở tiệc đấy!
Dialogue: 9,0:21:14.86,0:21:15.84,Main,,0,0,0,,Trả lời đi.
Dialogue: 9,0:21:16.65,0:21:18.13,Main,,0,0,0,,Báo cáo tình hình đi!
Dialogue: 9,0:21:18.53,0:21:21.46,Main,,0,0,0,,Tôi lặp lại, báo cáo tình hình!
Dialogue: 9,0:21:21.91,0:21:23.88,Main,,0,0,0,,Này! Sao thế?
Dialogue: 9,0:21:39.32,0:21:40.59,Main,,0,0,0,,Không lẽ...
Dialogue: 9,0:21:40.59,0:21:41.59,Main,,0,0,0,,Ui là trời.
Dialogue: 9,0:21:42.84,0:21:45.33,Main,,0,0,0,,Lần này ra tay ngoạn mục quá nhỉ.
Dialogue: 9,0:21:46.16,0:21:49.41,Main,,0,0,0,,Việc xử lý xác chết \Nxin nhờ bên các vị lo hộ.
Dialogue: 9,0:21:50.14,0:21:51.91,Main,,0,0,0,,Này, sao thế?
Dialogue: 9,0:21:52.31,0:21:53.87,Main,,0,0,0,,Báo cáo tình hình đi!
Dialogue: 9,0:22:03.64,0:22:05.16,Main,,0,0,0,,Hạ toàn bộ sao?
Dialogue: 9,0:22:05.66,0:22:06.76,Main,,0,0,0,,Vô lý!
Dialogue: 9,0:22:07.30,0:22:08.32,Main,,0,0,0,,Được rồi.
Dialogue: 9,0:22:08.72,0:22:10.45,Main,,0,0,0,,Đã qua bài kiểm tra.
Dialogue: 9,0:22:11.66,0:22:13.52,Main,,0,0,0,,Mục tiêu là anh ta.
